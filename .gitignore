# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Personal and internal documents stay out of this public repo (SWED-107; scripts/private_files.py checks it).
# The two strategy PDFs that scripts/read_first.py reads live on the owner's machine only.
/design/*Resume*
/design/*Case Study*
/design/design-builder-role*
/design/SwipeEd - Project Summary.docx
/design/The-Equal-Lens-Brand-Guidelines*
/Strategy/*Game Strategy (build bible)*
/Strategy/*Transition Plan*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Equal Lens website: reference material only, not part of this app
/The Equal Lens/

# Lazyweb design-research artifacts (tool output)
.lazyweb/

# forge content-pipeline working state (plans, generated batches, all regenerable)
.forge/

# transient Plane active-issue marker (per-session)
.plane_current_issue

# Raw CC0 source kits (Kenney/Quaternius). The USED subset is vendored in public/models/;
# these are the originals, re-downloadable, and 61MB has no business in git history.
/assets/
