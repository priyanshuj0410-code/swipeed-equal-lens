#!/usr/bin/env bash
# SwipeEd read-first guard (the hard rule, enforced at commit time).
# When a commit touches game content/components, this surfaces the AUTHORITATIVE build status + the next
# node straight from the master node table (scripts/master-node-table.xlsx) and BLOCKS on inconsistency,
# so build progress / "the next node" can never be asserted from memory. See scripts/swipeed_status.py.
ROOT="$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '^src/(content|components)/games/'; then
  echo "▸ SwipeEd read-first guard: game files staged. Authoritative build status (master node table):"
  echo
  if python3 "$ROOT/scripts/swipeed_status.py" --check; then
    echo
    echo "  (^ confirm the node you built matches the NEXT shown above before stating progress.)"
  else
    echo
    echo "⛔ Commit blocked: SwipeEd build-status inconsistency (see above)."
    echo "   Fix it, or bypass once with:  SWIPEED_STATUS_OVERRIDE=1 git commit ..."
    exit 1
  fi

  # Read-first source-doc gate: a NEW v2 build may not be committed without a hash-pinned attestation
  # that its bible + transition plan + GDD + chapter personas + scenario library were read. See read_first.py.
  echo
  if python3 "$ROOT/scripts/read_first.py" --gate; then
    :
  else
    echo
    echo "⛔ Commit blocked: a NEW game build is staged with no valid read-first attestation."
    echo "   Read its 5 source docs, then:  python3 scripts/read_first.py --attest gXX  &&  git add .read-first/gXX.json"
    echo "   (inspect required docs first with:  python3 scripts/read_first.py --require gXX)"
    echo "   Deliberate bypass once with:  READ_FIRST_OVERRIDE=1 git commit ..."
    exit 1
  fi
fi

# Content gate (SWED-72): the same checks every build runs, caught here before the commit instead of at deploy.
# Shapes, helplines on every field, lengths, band ceilings, bank size and mix over the whole bank, plus the gate's
# own fixtures. See scripts/content_gate.py. There is no build-time override: a commit that skips this still
# fails on Vercel.
if git diff --cached --name-only | grep -qE '^(src/content/|scripts/content_gate\.py|scripts/forge/)'; then
  echo
  if [ "${SWIPEED_CONTENT_GATE_OVERRIDE:-}" = "1" ]; then
    echo "▸ content gate: SKIPPED for this commit (SWIPEED_CONTENT_GATE_OVERRIDE=1); the build will still run it"
  elif python3 "$ROOT/scripts/content_gate.py" && python3 "$ROOT/scripts/forge/test_gates.py" >/dev/null; then
    :
  else
    echo
    echo "⛔ Commit blocked: the content gate failed (see above, or run: python3 scripts/forge/test_gates.py)."
    echo "   Fix the content, or bypass this commit only with:  SWIPEED_CONTENT_GATE_OVERRIDE=1 git commit ..."
    exit 1
  fi
fi
# Dash gate (SWED-92): The Equal Lens never uses em or en dashes, in copy, comments, scripts or docs.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  if ! git diff --cached --name-only --diff-filter=ACMR -z | (cd "$ROOT" && xargs -0 python3 scripts/no_dashes.py) >/dev/null; then
    git diff --cached --name-only --diff-filter=ACMR -z | (cd "$ROOT" && xargs -0 python3 scripts/no_dashes.py)
    echo
    echo "⛔ Commit blocked: rewrite those lines without dashes (two sentences, a comma, a colon, or \"like\")."
    exit 1
  fi
fi
exit 0
