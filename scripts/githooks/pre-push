#!/usr/bin/env bash
# Public-repo guard (SWED-110): refuse a push whose new commits add a private or purged file, such as a branch still
# built on the history from before the 2026-10-01 purges. The check lives in scripts/private_files.py --push.
ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
revs=()
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  revs+=("$local_sha")
done
[ ${#revs[@]} -eq 0 ] && exit 0
python3 "$ROOT/scripts/private_files.py" --push "${revs[@]}"
